{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "program-desk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "program-desk",
      "database_id": "346e87d2-8300-44c2-95e9-adb4f6706404",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "EMAIL_MODE": "outbox",
    "ACCELEVENTS_SYNC_MODE": "outbox"
  },
  "observability": {
    "enabled": true
  }
}
